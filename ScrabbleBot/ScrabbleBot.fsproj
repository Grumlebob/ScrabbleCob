<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RepositoryUrl>https://github.com/jesper-bengtson/Scrabble-FP2021/</RepositoryUrl>
    <TargetFramework>net6.0</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Company>IT University of Copenhagen</Company>
    <Version>1.0.0</Version>
    <PackageId>ScrabblingBot</PackageId>
    <AssemblyName>ScrabblingBot</AssemblyName>
    <Authors>Your names go here (optional since this is hosted in a public Github repository)</Authors>
    <Product>The bot name goes here</Product>
    <Description>Scrabble Bot for Functional Programming 2021
      Group name: &lt;The Scrabbling&gt;</Description>
  </PropertyGroup>
  
  <ItemGroup>
    <Compile Include="MultiSet.fsi" />
    <Compile Include="MultiSet.fs" />
    <Compile Include="FParsecLight.fsi" />
    <Compile Include="FParsecLight.fs" />
    <Compile Include="StateMonad.fsi" />
    <Compile Include="StateMonad.fs" />
    <Compile Include="Eval.fs" />
    <Compile Include="Parser.fsi" />
    <Compile Include="Parser.fs" />
    <Compile Include="Scrabble.fsi" />
    <Compile Include="Scrabble.fs" />
    <Compile Include="ScrabbleGrumbo.fs" />
    <Compile Include="ScrabbleManual.fs" />
    <Compile Include="Scrabble2.fs" />
  </ItemGroup>
  
  <ItemGroup>
    <Reference Include="ScrabbleUtil">
      <HintPath>../ScrabbleUtil.dll</HintPath>
    </Reference>
    
    <PackageReference Include="FParsec" Version="1.1.1" />
    <PackageReference Update="FSharp.Core" Version="6.0.3" />
  </ItemGroup>
  
</Project>